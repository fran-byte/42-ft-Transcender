FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /work

# torch + numpy already in the base image; pin numpy to the version dqn.py expects.
RUN pip install --no-cache-dir "numpy==1.26.4"

COPY train/ ./train/

WORKDIR /work/train
CMD ["python", "train.py"]
